# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://printq:dev-only-not-a-secret@localhost:5432/printq?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Public origin of the app. Cookies, invitation links, set-password links and
# the WebAuthn relying party are all derived from this — it MUST match what
# the browser sees.
BETTER_AUTH_URL="http://localhost:3000"

# 32+ random bytes. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-change-me-openssl-rand-base64-32"

# WebAuthn relying party. rpID is the registrable domain WITHOUT scheme or
# port; passkeys are bound to it and cannot be moved to another domain later.
PASSKEY_RP_ID="localhost"
PASSKEY_RP_NAME="PrintQ - Requests"

# ---------------------------------------------------------------------------
# The first admin is not seeded. On a fresh database, open /setup once to
# claim the printer (name, email, username, password). No variables needed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Webhook — OPTIONAL. When set, every in-app notification the print team
# receives is also POSTed as { "text": "…" } — the shape Discord and Slack
# webhook URLs accept without configuration. Failures are logged and ignored:
# a down chat relay never blocks the queue.
# WEBHOOK_URL=""
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Email — OPTIONAL. Picks a transport in this order: RESEND_API_KEY, then
# SMTP_URL, then none at all, which is a supported mode.
#
# Nobody needs mail to sign in: people use a username and a password. Mail
# only ever carries a link — an invitation, or a password reset — and with no
# transport configured the admin is shown that link on screen to hand over
# instead.
# ---------------------------------------------------------------------------
MAIL_FROM="PrintQ - Requests <printer@example.org>"
# RESEND_API_KEY=""
SMTP_URL="smtp://localhost:1025"

# Refuse a password that is in a known breach corpus (api.pwnedpasswords.com,
# checked by k-anonymity — the password never leaves the machine). Set this to
# "true" ONLY on a deployment with no outbound internet at all: the check
# fails closed, so without it nobody could register.
# HIBP_DISABLED="false"

# ---------------------------------------------------------------------------
# Where model files are written
# ---------------------------------------------------------------------------
# A directory, not a service. `npm run dev` needs no container for this.
MODELS_ROOT="./data/uploads"
