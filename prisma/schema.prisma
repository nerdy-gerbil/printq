// Pretty Please Print — schema
//
// Two groups of models:
//   * Auth      — owned by Better Auth (User/Session/Account/Verification/Passkey).
//                 Shapes are dictated by the library; verify with
//                 `npx @better-auth/cli generate` after changing plugins.
//   * Domain    — Invite/Story/Comment/Notification, from the handoff data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Auth
// ===========================================================================

enum Role {
  user
  manager
  admin
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// --- username plugin ---
  ///
  /// The login identifier. Folded to lower case on write, which is what makes
  /// the unique index case-insensitive; `displayUsername` keeps whatever was
  /// typed so the profile can show it back.
  ///
  /// Nullable because an account can exist before it has one: the first
  /// admin is created through the first-run /setup page, and picks a username
  /// and a password there.
  username        String? @unique
  displayUsername String?

  /// Avatar fallback, e.g. "AY". Derived from `name` on create. The default is
  /// a safety net only — `databaseHooks.user.create.before` always sets it.
  initials String @default("??")

  /// The access level. `user` files requests, `manager` works the print
  /// queue alongside admins, and `admin` additionally runs the admin surface
  /// (invites, members, materials, rates, audit, wishlist). There is no
  /// single-admin constraint: any number of admins is allowed.
  role Role @default(user)

  /// Who invited this user. Null for the first admin from /setup.
  invitedById  String?
  invitedBy    User?   @relation("Invitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[]  @relation("Invitations")

  // --- admin plugin ---
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]
  passkeys Passkey[]

  invitesSent   Invite[]       @relation("InviteAuthor")
  auditEvents   AuditEvent[]   @relation("AuditActor")
  stories       Story[]
  comments      Comment[]
  notifications Notification[]

  /// The 'frr' feature-request track — a parallel backlog to the print one.
  featureRequests FeatureRequest[]
  featureComments FeatureComment[]

  wishlistItems WishlistItem[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- admin plugin ---
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id        String @id @default(cuid())
  accountId String

  /// Namespace for `accountId`, so a provider id can never collide with an
  /// internal method. Better Auth writes `local:credential` for a password
  /// account; an OAuth provider would get its own issuer. Required by the
  /// library, and the left half of the uniqueness rule below.
  issuer                String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// scrypt digest as `salt:hash`, written by Better Auth. Only
  /// `providerId: "credential"` rows carry one; a passkey has no password.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

/// Better Auth's generic token store. Backs password-reset links and the
/// WebAuthn challenges. `verification.storeIdentifier: "hashed"` in
/// src/lib/auth.ts means `identifier` holds a digest, not the token — a
/// database reader cannot replay a live reset link.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// WebAuthn credential. `publicKey` is a public key — safe at rest — and the
/// private half never leaves the authenticator.
model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

/// Backs `rateLimit: { storage: "database" }` in src/lib/auth.ts. Shape is
/// dictated by Better Auth: `key` unique, `lastRequest` an epoch-millisecond
/// bigint. Rows are disposable — truncating it only resets the counters.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ===========================================================================
// Domain
// ===========================================================================

/// An invitation to join. There is no public sign-up: a `User` row can only
/// come into existence when a matching pending invite exists (enforced in
/// `src/lib/auth.ts` via `user.validateUserInfo`).
model Invite {
  id    String @id @default(cuid())
  email String

  /// SHA-256 of the invite token. The raw token exists only inside the
  /// emailed link — a database dump does not let anyone accept an invite.
  tokenHash String @unique

  /// Display name the admin suggested; the invitee can override it on claim.
  name String?
  role Role    @default(user)

  invitedById String
  invitedBy   User   @relation("InviteAuthor", fields: [invitedById], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  /// Last time the link was (re)sent, for throttling resends in the UI.
  sentAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("invite")
}

/// Append-only record of who did what. Closes the A09 gap from SECURITY.md.
///
/// Deliberately denormalised: `actorEmail` and `subject` are copied in at
/// write time so the trail still reads correctly after the user or the story
/// it refers to has been deleted. Nothing in the app ever updates a row here.
model AuditEvent {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  /// Dotted verb, e.g. "invite.sent", "story.status_changed".
  action String

  actorId    String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Kept even if the account is later removed.
  actorEmail String?

  /// What was acted on, in human terms: "PPP-104", "ayla@office.example".
  subject String?

  ip        String?
  userAgent String?
  /// Anything else worth keeping. Never put a token or a raw file in here.
  detail    Json?

  @@index([at])
  @@index([action, at])
  @@index([actorId])
  @@map("auditEvent")
}

enum StoryStatus {
  Requested
  Accepted
  Printing
  Done
  Delivery
  Declined
}

model Story {
  /// Autoincrement so the display ref stays "PrintQ-" + (100 + id).
  id     Int         @id @default(autoincrement())
  title  String
  status StoryStatus @default(Requested)

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  quantity  Int    @default(1)
  /// Plain string, not an enum — materials are owner-managed data (see the
  /// Material model and src/lib/materials.ts), mirroring how Benefit handles
  /// the tip catalogue. A retired material is kept exactly like a retired
  /// benefit: past tickets that used it still read correctly, it just drops
  /// off the upload form's choices.
  material  String @default("PETG")
  colorName String
  colorHex  String

  /// Extra colours for a multi-colour print (AMS/MMU/manual filament swap),
  /// beyond the primary colorName/colorHex above. Plain array of catalogue
  /// names — short (capped at 3 extra), never queried on its own, and a join
  /// table would only earn its keep past that scale.
  additionalColorNames String[] @default([])

  /// Where the model came from, if not made by the requester — a Makeronline,
  /// Printables, MakerWorld or Thingiverse URL, say. No fetching happens
  /// against it at upload time; this is a reference link on the ticket so the
  /// print team can open the source page themselves. Optional.
  sourceUrl String?
  tip       String
  note      String  @default("")

  /// Free-text print settings the requester optionally notes (layer height,
  /// infill, supports, temps…), shown to the owner on the ticket so specifics
  /// do not become a back-and-forth. FRR-103, option A — a plain string, not a
  /// structured/gated "advanced mode".
  printSettings String @default("")

  flagged    Boolean @default(false)
  flagReason String?

  // --- uploaded asset. Bytes live in object storage, never the web root. ---
  filename   String
  fileSize   Int
  mimeType   String
  storageKey String

  // --- measured from the mesh at upload time, display only ---
  //
  // There is deliberately no `estimate` column. A print time derived from the
  // bounding box is a guess dressed as a measurement, and the handoff's
  // definition of done rules out claiming to know what the printer will do.
  // A real slicer integration would add one back — see src/lib/models.ts.
  dims String?

  /// Actual filament used, in grams — entered by the print team once known
  /// (weighed, or read off the slicer after the real print), never guessed
  /// at upload time. Cost is derived from this plus printMinutes and the
  /// current MaterialRate — see src/lib/cost.ts.
  weightGrams  Int?
  /// Actual wall-clock print time in minutes, entered the same way as
  /// weightGrams. Deliberately not an estimate at any point in the flow.
  printMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      Comment[]
  notifications Notification[]

  @@index([uploaderId])
  @@index([status])
  @@map("story")
}

model Comment {
  id        String   @id @default(cuid())
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([storyId])
  @@map("comment")
}

model Notification {
  id          String          @id @default(cuid())
  recipientId String
  recipient   User            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  storyId     Int?
  story       Story?          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// A notification points at a print story OR a feature request (or neither,
  /// for a withdrawal). The two id columns are mutually exclusive in practice;
  /// the Activity feed routes to /story or /frr on whichever is set.
  featureId   Int?
  feature     FeatureRequest? @relation(fields: [featureId], references: [id], onDelete: Cascade)
  text        String
  read        Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([recipientId, read])
  @@map("notification")
}

// ===========================================================================
// Materials — owner-managed, like the tip catalogue
// ===========================================================================

model Material {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("material")
}

/// Owner-managed $/kg by material — an input of the cost calculator
/// (src/lib/cost.ts). `material` is a plain string, not a foreign key to
/// Material.name: a rate for a since-retired or since-renamed material keeps
/// working rather than cascade-deleting, the same reason Story.material is a
/// plain string.
model MaterialRate {
  material     String   @id
  dollarsPerKg Float
  updatedAt    DateTime @updatedAt

  @@map("material_rate")
}

/// The single shared hourly machine rate (electricity, wear, amortised
/// upkeep). One row, id fixed at "default".
model MachineRate {
  id             String   @id @default("default")
  dollarsPerHour Float
  updatedAt      DateTime @updatedAt

  @@map("machine_rate")
}

// ===========================================================================
// Wishlist — models the admins would like to print some day
// ===========================================================================

/// A link to a 3D model somebody would like printed later, when there is
/// time, filament or a reason. The page's title and thumbnail are fetched at
/// save time (src/lib/wishlist.ts); the bytes of the thumbnail are cached
/// under MODELS_ROOT/thumbs and served through /api/wishlist/[id]/thumb so
/// the CSP's img-src stays 'self'. Nothing is ever fetched from the URL on
/// behalf of a viewer afterwards — the row is the snapshot.
model WishlistItem {
  id           String   @id @default(cuid())
  url          String   @unique
  title        String
  /// Storage key of the cached thumbnail, or null when none could be fetched.
  thumbnailKey String?
  /// Source label, e.g. "Makeronline" — see src/lib/model-sources.ts.
  source       String
  note         String   @default("")
  addedById    String
  addedBy      User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@map("wishlistItem")
}

// ===========================================================================
// Feature requests — the 'frr' track
//
// A parallel backlog: users file feature requests, the printer owner triages
// them with the same flow, conversation, notifications and audit trail as a
// print. Kept in its own tables rather than folded into Story, which stays
// purely about printed models. The status flow mirrors the print one's shape
// (forward-only, one step, Done leaves the board, Declined terminal from
// Requested) with feature-appropriate names — see FEATURE_FLOW in scope.ts.
// ===========================================================================

enum FeatureStatus {
  Requested
  Accepted
  InProgress
  Shipped
  Done
  Declined
}

enum FeaturePriority {
  low
  medium
  high
}

enum FeatureCategory {
  ui
  api
  bug
  other
}

model FeatureRequest {
  /// Autoincrement so the display ref stays "FRR-" + (100 + id).
  id          Int             @id @default(autoincrement())
  title       String
  description String          @default("")
  status      FeatureStatus   @default(Requested)
  priority    FeaturePriority @default(medium)
  category    FeatureCategory @default(other)

  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      FeatureComment[]
  notifications Notification[]

  @@index([requesterId])
  @@index([status])
  @@map("featureRequest")
}

model FeatureComment {
  id        String         @id @default(cuid())
  featureId Int
  feature   FeatureRequest @relation(fields: [featureId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime       @default(now())

  @@index([featureId])
  @@map("featureComment")
}

/// A "benefit" — the tip a requester offers the printer owner ("what's in it
/// for you"). Owner-managed data, replacing the old hardcoded TIPS const, so
/// the owner defines the list and marks which ones they currently prefer.
///
/// `Story.tip` stays a plain string with no FK: a past request keeps the exact
/// tip it was made with even after the list is edited or a benefit retired.
/// `active` retires a benefit without deleting that history; `preferred` is
/// what the upload form highlights.
model Benefit {
  id        String   @id @default(cuid())
  label     String   @unique
  preferred Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("benefit")
}
